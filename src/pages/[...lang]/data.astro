        <div class="relative bg-white rounded-[2.5rem] p-10 border-2 border-transparent shadow-soft flex flex-col group/card transition-colors duration-300 hover:border-brand-blue-deep shrink-0">
          <div class="flex justify-between items-start mb-6">
            <span class="px-3 py-1.5 rounded-lg bg-brand-blue-deep/5 text-brand-blue-deep font-bold text-[10px] uppercase tracking-[0.15em] border border-brand-blue-deep/10">{content.explorerCard.tag}</span>
            <div class="relative flex h-3 w-3 mt-1 mr-1">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-teal opacity-60"></span>
              <span class="aurora-dot relative inline-flex rounded-full h-3 w-3 shadow-sm ring-2 ring-white"></span>
            </div>
          </div>
          <h2 class="text-3xl font-black tracking-tight text-gray-900 mb-3">{content.explorerCard.title}</h2>
          <p class="text-gray-500 text-sm leading-relaxed font-medium mb-8">{content.explorerCard.description}</p>
          <a href={`${baseUrl}${langPrefix}/data/explorer/`} class="group/action w-full py-4 rounded-xl bg-brand-blue-deep text-white text-sm font-bold shadow-lg flex items-center justify-center gap-3 cursor-pointer transition-all duration-300 hover:brightness-110">
            <span class="relative z-10">{content.explorerCard.buttonText}</span>
            <svg class="arrow-bounce-card relative z-10 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>

        <div class="relative bg-white rounded-[2.5rem] p-10 flex flex-col justify-center flex-grow group/card border-2 border-transparent shadow-soft transition-colors duration-300 hover:border-brand-blue-deep">
          <div class="relative z-10">
            <span class="w-14 h-14 rounded-2xl bg-brand-blue-deep/5 flex items-center justify-center mb-6 border border-brand-blue-deep/10 transition-colors group-hover/card:bg-brand-blue-deep/10">
              <svg class="w-7 h-7 text-brand-blue-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </span>
            <h2 class="text-2xl font-black text-gray-900 mb-3">{content.actionBlock.title}</h2>
            <p class="text-gray-500 mb-8 text-sm leading-relaxed font-medium">{content.actionBlock.description}</p>
            <a href="https://github.com/bio-portal/mybioportal_frontend/blob/main/public/docs/BIO-PORTAL-Data-Access-Form.Feb-23-2026-2.pdf?raw=true" target="_blank" rel="noopener noreferrer" class="group/action w-full py-4 rounded-xl bg-brand-blue-deep text-white font-bold text-sm tracking-wide shadow-lg flex items-center justify-center gap-3 cursor-pointer mb-8 transition-all duration-300 hover:brightness-110">
              <span class="relative z-10">{content.actionBlock.downloadButtonText}</span>
              <svg class="arrow-bounce-card relative z-10 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </a>
            <div class="pt-6 border-t border-gray-100">
              <p class="text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-1">{content.actionBlock.emailLabel}</p>
              <a href={`mailto:${content.actionBlock.emailAddress}`} class="text-base font-bold text-brand-dark hover:text-brand-blue-deep transition-colors">
                {content.actionBlock.emailAddress}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /*
   * IMPORTANT: <style is:global> is required in Astro to style DOM elements
   * that are injected dynamically by client-side Javascript.
   */
  .radial-section-wrapper { min-height: 600px; }
  #radial-container { position: relative; }
  #svg-layer { pointer-events: none; }

  .spoke-line {
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
  }

  .spoke-dot { transition: opacity 0.4s ease; }

  .data-node {
      position: absolute;
      z-index: 5;
      width: max-content;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .node-val {
      font-size: 2.25rem;
      font-weight: 300;
      letter-spacing: -0.02em;
      margin-bottom: 0.15rem;
      line-height: 1;
      color: #0f172a;
  }

  .data-node.right-side .node-val { text-align: left; }
  .data-node.left-side .node-val { text-align: right; }

  .node-lbl {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #64748b;
  }

  /* Center Hub Styles */
  #real-logo { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .group\/hub:hover #real-logo { transform: scale(1.06); }

  .logo-piece {
      transform-origin: center;
      transform-box: fill-box;
      opacity: 0;
      transform: scale(0);
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
  }

  /* Center Text */
  #hub-text-container {
      position: absolute; z-index: 20; display: flex; flex-direction: column;
      align-items: center; pointer-events: none; width: 90px;
  }
  .hub-text-en {
      font-weight: 900; font-size: 1.05rem; color: #0f172a;
      letter-spacing: -0.01em; line-height: 1.1; display: flex;
      flex-direction: column; align-items: center; transition: color 0.3s ease;
  }
  .hub-text-en-row { display: flex; align-items: center; justify-content: center; gap: 2px; margin-left: 12px; }
  .hub-text-fr {
      font-weight: 800; font-size: clamp(0.7rem, 1vw, 0.85rem);
      color: #0f172a; letter-spacing: 0.05em; transition: color 0.3s ease;
  }
  .group\/hub:hover .hub-text-en, .group\/hub:hover .hub-text-fr { color: #0284c7; }

  /* Center Arrow Bounce (Matches Astro Card) */
  .arrow-thrust {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.3s ease;
  }
  @keyframes centerArrowThrust {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }
  .group\/hub:hover .arrow-thrust {
      animation: centerArrowThrust 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Mobile Node Style */
  .mobile-node {
      display: flex; flex-direction: column; position: relative; padding-left: 1.5rem;
  }
  .mobile-node::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
      border-radius: 3px; background-color: var(--accent-color);
  }

  /* Existing Astro Card Animations */
  .aurora-dot {
    background: linear-gradient(135deg, var(--color-brand-blue-deep), var(--color-brand-teal), var(--color-brand-green-bright), var(--color-brand-yellow), var(--color-brand-orange-deep));
    background-size: 300% 300%;
    animation: auroraSpin 4s ease infinite;
  }
  @keyframes auroraSpin {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @keyframes arrowDip {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  .group\/action:hover .arrow-bounce-card { animation: arrowDip 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

  @keyframes arrowThrustCard {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }
  .group\/action:hover .arrow-thrust-card { animation: arrowThrustCard 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
</style>

<script define:vars={{ clientMetrics }}>
  // Ensure the DOM is fully parsed in Astro before firing SVG math
  document.addEventListener("DOMContentLoaded", () => {

    const radialContainer = document.getElementById('radial-container');
    const svgLayer = document.getElementById('svg-layer');
    const mobileContainer = document.getElementById('mobile-container');
    const svgEl = document.getElementById('base-svg');

    if (!radialContainer || !svgLayer || !mobileContainer || !svgEl) return;

    const nodes = [];
    const paths = [];
    const dots = [];
    const logoPiecesData = [];

    // 1. Initial DOM Setup (Invisible initially)
    clientMetrics.forEach((m, i) => {
        // Desktop Node (Flat colors for text, data-driven stroke logic)
        const div = document.createElement('div');
        div.className = 'data-node';
        div.innerHTML = `<div class="node-val">${m.value}</div><div class="node-lbl">${m.label}</div>`;
        radialContainer.appendChild(div);
        nodes.push({ element: div, data: m, index: i });

        // Mobile Node
        const mDiv = document.createElement('div');
        mDiv.className = 'mobile-node';
        mDiv.innerHTML = `<div class="node-val">${m.value}</div><div class="node-lbl">${m.label}</div>`;
        mobileContainer.appendChild(mDiv);
    });

    // 2. Setup Geometry & Animate In
    function setupLayout(isInitialLoad) {
        if (window.innerWidth <= 1024) {
            nodes.forEach(n => n.element.style.display = 'none');
            svgLayer.innerHTML = '';
            return;
        }

        nodes.forEach(n => n.element.style.display = 'block');
        svgLayer.innerHTML = '';
        paths.length = 0;
        dots.length = 0;

        const centerX = radialContainer.clientWidth / 2;
        const centerY = radialContainer.clientHeight / 2;
        const hubRadius = 140;
        const radialExt = 30;
        const horizExt = 90;
        const totalNodes = nodes.length;
        const startAngle = -Math.PI / 2.5;

        // Auto-crop ViewBox to get accurate SVG bounds
        const bbox = svgEl.getBBox();
        svgEl.setAttribute('viewBox', `${bbox.x - 2} ${bbox.y - 2} ${bbox.width + 4} ${bbox.height + 4}`);
        const cx = bbox.x + bbox.width / 2;
        const cy = bbox.y + bbox.height / 2;
        const svgScale = bbox.width / 220; // 220px is the CSS width of #real-logo

        // Map SVG pieces if not done yet
        if (logoPiecesData.length === 0) {
            document.querySelectorAll('.logo-piece').forEach((piece) => {
                const pBbox = piece.getBBox();
                logoPiecesData.push({
                    pcx: pBbox.x + pBbox.width / 2,
                    pcy: pBbox.y + pBbox.height / 2,
                    color: window.getComputedStyle(piece).fill
                });
            });
        }

        nodes.forEach((nodeObj, i) => {
            const angle = startAngle + (i * (Math.PI * 2) / totalNodes);
            const isRightSide = Math.cos(angle) >= 0;
            nodeObj.element.classList.add(isRightSide ? 'right-side' : 'left-side');

            // DOM Screen Coordinates
            const startX = centerX + Math.cos(angle) * hubRadius;
            const startY = centerY + Math.sin(angle) * hubRadius;
            const elbowX = startX + Math.cos(angle) * radialExt;
            const elbowY = startY + Math.sin(angle) * radialExt;
            const finalX = isRightSide ? elbowX + horizExt : elbowX - horizExt;
            const finalY = elbowY;

            // Find closest color block in SVG space
            const svgStartX = cx + ((startX - centerX) * svgScale);
            const svgStartY = cy + ((startY - centerY) * svgScale);

            let closestColor = nodeObj.data.color; // fallback to hardcoded
            let minDistance = Infinity;
            logoPiecesData.forEach(p => {
                const dist = Math.hypot(p.pcx - svgStartX, p.pcy - svgStartY);
                if (dist < minDistance) {
                    minDistance = dist;
                    closestColor = p.color;
                }
            });

            // Set Mobile Line Accent
            mobileContainer.children[i].style.setProperty('--accent-color', closestColor);

            // Position Text Nodes
            const textOffset = 15;
            nodeObj.element.style.left = `${isRightSide ? finalX + textOffset : finalX - textOffset}px`;
            nodeObj.element.style.top = `${finalY}px`;

            // Build SVG Path
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('class', 'spoke-line');
            path.setAttribute('stroke', closestColor);
            path.setAttribute('d', `M ${startX} ${startY} L ${elbowX} ${elbowY} L ${finalX} ${finalY}`);

            // Build SVG Dot
            const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            dot.setAttribute('class', 'spoke-dot');
            dot.setAttribute('cx', finalX);
            dot.setAttribute('cy', finalY);
            dot.setAttribute('r', '4');
            dot.setAttribute('fill', closestColor);

            if (isInitialLoad) {
                path.style.opacity = '0';
                nodeObj.element.style.transform = isRightSide ? 'translate(20px, -50%)' : 'translate(-120%, -50%)';
            } else {
                nodeObj.element.style.opacity = '1';
                nodeObj.element.style.transform = isRightSide ? 'translate(0, -50%)' : 'translate(-100%, -50%)';
                dot.style.opacity = '1';
            }

            svgLayer.appendChild(path);
            svgLayer.appendChild(dot);
            paths.push(path);
            dots.push(dot);
            nodeObj.isRight = isRightSide;
        });
    }

    // Run setup instantly to prevent flashes
    setupLayout(true);

    // Sequence Animations
    if (window.innerWidth > 1024) {
        // 0ms: Logo Pop-in
        const logoPieces = Array.from(document.querySelectorAll('.logo-piece'));
        const shuffled = logoPieces.sort(() => 0.5 - Math.random());
        shuffled.forEach((piece, i) => {
            setTimeout(() => {
                piece.style.opacity = '1';
                piece.style.transform = 'scale(1)';
            }, i * 3);
        });

        // 200ms: Draw Lines from Center
        setTimeout(() => {
            paths.forEach(path => {
                const length = path.getTotalLength();
                path.style.strokeDasharray = length;
                path.style.strokeDashoffset = length;
                path.style.opacity = '1';

                path.getBoundingClientRect(); // force reflow
                path.style.transition = 'stroke-dashoffset 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
                path.style.strokeDashoffset = '0';
            });
        }, 200);

        // 800ms: Fade in Dots & Slide Text
        setTimeout(() => {
            dots.forEach(d => d.style.opacity = '1');
            nodes.forEach((n, i) => {
                setTimeout(() => {
                    n.element.style.opacity = '1';
                    n.element.style.transform = n.isRight ? 'translate(0, -50%)' : 'translate(-100%, -50%)';
                }, i * 40); // Soft micro-stagger
            });
        }, 800);
    }

    // 3. Perfect Resizing (Debounced)
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            setupLayout(false);
        }, 50);
    });

  });
</script>
