---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'en' } = Astro.params;
const langPrefix = lang === 'en' ? '' : '/fr';
// 🌟 FIXED: Safe RegExp instantiation prevents esbuild parsing errors on '$'
const baseUrl = import.meta.env.BASE_URL.replace(new RegExp('/$'), '');

const pageData = await getEntry('pages', `${lang}/data`);

const hero = pageData?.data?.hero || { tagline: 'Data', headline: 'BioPortal Datasets', description: 'Loading data...' };

const rawMetrics = pageData?.data?.landingMetrics || [];

const brandHexColors = ['#0284c7', '#0d9488', '#0ea5e9', '#16a34a', '#eab308', '#f97316', '#ea580c'];

const clientMetrics = rawMetrics.map((m: any, i: number) => ({
  label: m.label,
  value: String(m.value),
  color: brandHexColors[i % brandHexColors.length]
}));

const content = pageData?.data?.dataRequest || {
  pageTitle: "Datasets",
  backText: "Back",
  explorerCard: { tag: "App", title: "Explorer", description: "Explore datasets", buttonText: "Open Explorer" },
  applicationProcess: {
    title: "Application Process",
    description: "",
    requirementsTitle: "Requirements",
    requirementsItems: [],
    infrastructureTitle: "Infrastructure",
    infrastructureDescription: "",
    infrastructureTags: []
  },
  actionBlock: {
    title: "Request Data",
    description: "",
    downloadButtonText: "Download Form",
    emailLabel: "Submit to:",
    emailAddress: "access.bioportal@ladydavis.ca"
  }
};
---

<Layout title={content.pageTitle} backText={content.backText} lang={lang}>
  <main class="max-w-7xl mx-auto px-6 pt-12 pb-24 relative z-10">
    <header class="max-w-3xl mb-5 text-center mx-auto">
      <span class="text-brand-blue-deep font-bold tracking-widest uppercase text-xs mb-4 block">{hero.tagline}</span>
      <h1 class="text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight mb-4 tracking-tight">{hero.headline}</h1>
      <p class="text-lg text-gray-600 leading-relaxed">{hero.description}</p>
    </header>

    <div class="radial-section-wrapper mb-7 relative w-full h-[390px] flex justify-center items-center">

      {/* DESKTOP VIEW */}
      <div id="radial-container" class="absolute inset-0 w-full h-full hidden lg:flex justify-center items-center" data-baseurl={baseUrl}>
        <svg id="svg-layer" class="absolute inset-0 w-full h-full z-[1] pointer-events-none"></svg>

        <a href={`${baseUrl}${langPrefix}/data/explorer/`} id="center-hub" class="absolute z-10 flex justify-center items-center cursor-pointer no-underline group/hub">
          <div id="real-logo" class="relative flex justify-center items-center w-[200px] h-[200px] transition-transform duration-400 ease-out group-hover/hub:scale-[1.06]">
            <!-- JS WILL FETCH AND INJECT /logos/BioPortal_Mark_Color.svg HERE -->
          </div>

          <div id="hub-text-container" class="absolute z-20 flex flex-col justify-center items-center pointer-events-none w-[90px]">
            {lang === 'fr' ? (
              <div class="hub-text-fr">
                Explorateur
                <svg class="arrow-thrust w-4 h-4 text-gray-900 group-hover/hub:text-brand-blue-deep mx-auto mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
              </div>
            ) : (
              <div class="hub-text-en">
                Explore
                <span class="hub-text-en-row">
                  Data
                  <svg class="arrow-thrust w-4 h-4 text-gray-900 group-hover/hub:text-brand-blue-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                </span>
              </div>
            )}
          </div>
        </a>
      </div>

      {/* MOBILE VIEW */}
      <div id="mobile-container" class="w-full flex lg:hidden flex-col gap-6 relative z-20">
        <!-- JS will populate mobile nodes here -->
      </div>
    </div>

    {/* Informational Cards Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch relative z-20">
      <div class="lg:col-span-7 bg-white rounded-[2.5rem] p-10 border border-gray-100 shadow-soft h-full flex flex-col">
        <h2 class="text-3xl font-black text-brand-dark mb-4">{content.applicationProcess.title}</h2>
        <p class="text-gray-500 mb-8 leading-relaxed font-medium text-lg">{content.applicationProcess.description}</p>

        <div class="flex-grow space-y-8">
          <div>
            <h3 class="text-lg font-bold mb-4 flex items-center gap-3 text-gray-900">
              <span class="w-8 h-8 rounded-full bg-brand-teal/20 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              </span>
              {content.applicationProcess.requirementsTitle}
            </h3>
            <ul class="space-y-3 text-sm text-gray-600 font-medium ml-11">
              {content.applicationProcess.requirementsItems?.map((item: string, index: number) => (
                <li class="flex items-start gap-3"><span class="text-brand-teal font-black mt-0.5 opacity-60">0{index + 1}</span><span class="leading-relaxed">{item}</span></li>
              ))}
            </ul>
          </div>

          <div class="pt-6 border-t border-gray-100">
            <h3 class="text-lg font-bold text-gray-900 mb-3">{content.applicationProcess.infrastructureTitle}</h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-4" set:html={content.applicationProcess.infrastructureDescription}></p>
            <div class="flex flex-wrap gap-2">
              {content.applicationProcess.infrastructureTags?.map((tag: string) => (
                <span class="px-3 py-1.5 rounded-lg bg-brand-blue-mid/10 text-brand-dark font-bold text-[10px] uppercase tracking-widest">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col gap-8 h-full">
        <div class="relative bg-white rounded-[2.5rem] p-10 border-2 border-transparent shadow-soft flex flex-col group/card transition-colors duration-300 hover:border-brand-blue-deep shrink-0">
          <div class="flex justify-between items-start mb-6">
            <span class="px-3 py-1.5 rounded-lg bg-brand-blue-deep/5 text-brand-blue-deep font-bold text-[10px] uppercase tracking-[0.15em] border border-brand-blue-deep/10">{content.explorerCard.tag}</span>
            <div class="relative flex h-3 w-3 mt-1 mr-1">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-teal opacity-60"></span>
              <span class="aurora-dot relative inline-flex rounded-full h-3 w-3 shadow-sm ring-2 ring-white"></span>
            </div>
          </div>
          <h2 class="text-3xl font-black tracking-tight text-gray-900 mb-3">{content.explorerCard.title}</h2>
          <p class="text-gray-500 text-sm leading-relaxed font-medium mb-8">{content.explorerCard.description}</p>
          <a href={`${baseUrl}${langPrefix}/data/explorer/`} class="group/action w-full py-4 rounded-xl bg-brand-blue-deep text-white text-sm font-bold shadow-lg flex items-center justify-center gap-3 cursor-pointer transition-all duration-300 hover:brightness-110">
            <span class="relative z-10">{content.explorerCard.buttonText}</span>
            <svg class="arrow-thrust-card relative z-10 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>

        <div class="relative bg-white rounded-[2.5rem] p-10 flex flex-col justify-center flex-grow group/card border-2 border-transparent shadow-soft transition-colors duration-300 hover:border-brand-blue-deep">
          <div class="relative z-10">
            <span class="w-14 h-14 rounded-2xl bg-brand-blue-deep/5 flex items-center justify-center mb-6 border border-brand-blue-deep/10 transition-colors group-hover/card:bg-brand-blue-deep/10">
              <svg class="w-7 h-7 text-brand-blue-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </span>
            <h2 class="text-2xl font-black text-gray-900 mb-3">{content.actionBlock.title}</h2>
            <p class="text-gray-500 mb-8 text-sm leading-relaxed font-medium">{content.actionBlock.description}</p>
            <a href="https://github.com/bio-portal/mybioportal_frontend/blob/main/public/docs/BIO-PORTAL-Data-Access-Form.Feb-23-2026-2.pdf?raw=true" target="_blank" rel="noopener noreferrer" class="group/action w-full py-4 rounded-xl bg-brand-blue-deep text-white font-bold text-sm tracking-wide shadow-lg flex items-center justify-center gap-3 cursor-pointer mb-8 transition-all duration-300 hover:brightness-110">
              <span class="relative z-10">{content.actionBlock.downloadButtonText}</span>
              <svg class="arrow-bounce-card relative z-10 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </a>
            <div class="pt-6 border-t border-gray-100">
              <p class="text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-1">{content.actionBlock.emailLabel}</p>
              <a href={`mailto:${content.actionBlock.emailAddress}`} class="text-base font-bold text-brand-dark hover:text-brand-blue-deep transition-colors">
                {content.actionBlock.emailAddress}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .spoke-line {
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
  }

  .spoke-dot { transition: opacity 0.4s ease; }

  .data-node {
      position: absolute;
      z-index: 5;
      max-width: 180px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .node-val {
      font-size: 2.25rem;
      font-weight: 300;
      letter-spacing: -0.02em;
      margin-bottom: 0.15rem;
      line-height: 1;
      color: #0f172a;
  }

  .data-node.right-side .node-val { text-align: left; }
  .data-node.left-side .node-val { text-align: right; }

  .node-lbl {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      line-height: 1.3;
      color: #64748b;
      white-space: normal;
  }

  #real-logo svg {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      overflow: visible;
  }

  .logo-piece {
      transform-origin: center;
      transform-box: fill-box;
      opacity: 0;
      transform: scale(0);
      transition: transform 0.75s cubic-bezier(0.55, 0.085, 0.68, 0.53), opacity 0.75s ease;
  }

  .hub-text-en, .hub-text-fr {
      opacity: 0;
      transition: opacity 0.5s ease, color 0.3s ease;
  }

  .hub-text-en {
      font-weight: 900; font-size: 1.15rem; color: #0f172a;
      letter-spacing: -0.01em; line-height: 1.1; display: flex;
      flex-direction: column; align-items: center;
  }
  .hub-text-en-row { display: flex; align-items: center; justify-content: center; gap: 2px; margin-left: 12px; }

  .hub-text-fr {
      font-weight: 800; font-size: clamp(0.7rem, 1vw, 0.95rem);
      color: #0f172a; letter-spacing: 0.05em; display: flex;
      flex-direction: column; align-items: center;
  }

  .group\/hub:hover .hub-text-en, .group\/hub:hover .hub-text-fr { color: #0284c7; }

  .arrow-thrust { transition: color 0.3s ease; }
  @keyframes centerArrowThrust {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }
  .group\/hub:hover .arrow-thrust {
      animation: centerArrowThrust 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mobile-node { display: flex; flex-direction: column; position: relative; padding-left: 1.5rem; }
  .mobile-node::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
      border-radius: 3px; background-color: var(--accent-color);
  }

  .aurora-dot {
    background: linear-gradient(135deg, var(--color-brand-blue-deep), var(--color-brand-teal), var(--color-brand-green-bright), var(--color-brand-yellow), var(--color-brand-orange-deep));
    background-size: 300% 300%;
    animation: auroraSpin 4s ease infinite;
  }
  @keyframes auroraSpin {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @keyframes arrowDip {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  .group\/action:hover .arrow-bounce-card { animation: arrowDip 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

  @keyframes arrowThrustCard {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }
  .group\/action:hover .arrow-thrust-card { animation: arrowThrustCard 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
</style>

<script define:vars={{ clientMetrics }}>
  document.addEventListener("DOMContentLoaded", async () => {

    const radialContainer = document.getElementById('radial-container');
    const svgLayer = document.getElementById('svg-layer');
    const mobileContainer = document.getElementById('mobile-container');
    const logoContainer = document.getElementById('real-logo');
    const centerTextEn = document.querySelector('.hub-text-en');
    const centerTextFr = document.querySelector('.hub-text-fr');
    const centerText = centerTextEn || centerTextFr;
    const baseUrl = radialContainer?.dataset.baseurl || '';

    if (!radialContainer || !svgLayer || !mobileContainer || !logoContainer) return;

    let rawPieces = [];

    const TIMING = {
        logoStaggerMs: 8,
        linesStartDelay: 350,
        linesDuration: '0.8s',
        nodesStartDelay: 950,
        centerTextDelay: 1300
    };

    try {
        const res = await fetch(`${baseUrl}/logos/BioPortal_Mark_Color.svg`);
        if (!res.ok) throw new Error('Failed to fetch logo SVG');
        const svgText = await res.text();
        logoContainer.innerHTML = svgText;

        const svgEl = logoContainer.querySelector('svg');
        if (svgEl) {
            svgEl.setAttribute('preserveAspectRatio', 'xMidYMid meet');
            rawPieces = svgEl.querySelectorAll('path, rect, polyline, polygon, circle');
            rawPieces.forEach(p => p.classList.add('logo-piece'));
        }
    } catch (err) {
        console.error("SVG Injection Error:", err);
        return;
    }

    const nodes = [];
    const paths = [];
    const dots = [];
    const logoPiecesData = [];

    clientMetrics.forEach((m, i) => {
        const div = document.createElement('div');
        div.className = 'data-node';
        div.innerHTML = `<div class="node-val">${m.value}</div><div class="node-lbl">${m.label}</div>`;
        radialContainer.appendChild(div);
        nodes.push({ element: div, data: m, index: i });

        const mDiv = document.createElement('div');
        mDiv.className = 'mobile-node';
        mDiv.innerHTML = `<div class="node-val">${m.value}</div><div class="node-lbl">${m.label}</div>`;
        mobileContainer.appendChild(mDiv);
    });

    function setupLayout(isInitialLoad) {
        if (window.innerWidth <= 1024) {
            nodes.forEach(n => n.element.style.display = 'none');
            svgLayer.innerHTML = '';
            return;
        }

        nodes.forEach(n => n.element.style.display = 'block');
        svgLayer.innerHTML = '';
        paths.length = 0;
        dots.length = 0;

        const centerX = radialContainer.clientWidth / 2;
        const centerY = radialContainer.clientHeight / 2;
        const hubRadius = 130;
        const radialExt = 30;
        const horizExt = 90;
        const totalNodes = nodes.length;
        const startAngle = -Math.PI / 2.5;

        const svgEl = logoContainer.querySelector('svg');
        if (!svgEl) return;

        let bbox = { x: 0, y: 0, width: 100, height: 100 };
        try { bbox = svgEl.getBBox(); } catch(e) {}

        svgEl.setAttribute('viewBox', `${bbox.x - 2} ${bbox.y - 2} ${bbox.width + 4} ${bbox.height + 4}`);
        const cx = bbox.x + bbox.width / 2;
        const cy = bbox.y + bbox.height / 2;
        const svgScale = bbox.width / 200;

        if (logoPiecesData.length === 0) {
            rawPieces.forEach((piece) => {
                let pBbox = { x: 0, y: 0, width: 0, height: 0 };
                try { pBbox = piece.getBBox(); } catch(e) {}
                logoPiecesData.push({
                    pcx: pBbox.x + pBbox.width / 2,
                    pcy: pBbox.y + pBbox.height / 2,
                    color: window.getComputedStyle(piece).fill
                });
            });
        }

        nodes.forEach((nodeObj, i) => {
            const angle = startAngle + (i * (Math.PI * 2) / totalNodes);
            const isRightSide = Math.cos(angle) >= 0;
            nodeObj.element.classList.add(isRightSide ? 'right-side' : 'left-side');

            const startX = centerX + Math.cos(angle) * hubRadius;
            const startY = centerY + Math.sin(angle) * hubRadius;
            const elbowX = startX + Math.cos(angle) * radialExt;
            const elbowY = startY + Math.sin(angle) * radialExt;
            const finalX = isRightSide ? elbowX + horizExt : elbowX - horizExt;
            const finalY = elbowY;

            const svgStartX = cx + ((startX - centerX) * svgScale);
            const svgStartY = cy + ((startY - centerY) * svgScale);

            let closestColor = nodeObj.data.color;
            let minDistance = Infinity;
            logoPiecesData.forEach(p => {
                const dist = Math.hypot(p.pcx - svgStartX, p.pcy - svgStartY);
                if (dist < minDistance && p.color !== 'none') {
                    minDistance = dist;
                    closestColor = p.color;
                }
            });

            mobileContainer.children[i].style.setProperty('--accent-color', closestColor);

            const textOffset = 15;
            nodeObj.element.style.left = `${isRightSide ? finalX + textOffset : finalX - textOffset}px`;
            nodeObj.element.style.top = `${finalY}px`;

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('class', 'spoke-line');
            path.setAttribute('stroke', closestColor);
            path.setAttribute('d', `M ${startX} ${startY} L ${elbowX} ${elbowY} L ${finalX} ${finalY}`);

            const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            dot.setAttribute('class', 'spoke-dot');
            dot.setAttribute('cx', finalX);
            dot.setAttribute('cy', finalY);
            dot.setAttribute('r', '4');
            dot.setAttribute('fill', closestColor);

            if (isInitialLoad) {
                path.style.opacity = '0';
                dot.style.opacity = '0';
                nodeObj.element.style.transform = isRightSide ? 'translate(20px, -50%)' : 'translate(-120%, -50%)';
            } else {
                nodeObj.element.style.opacity = '1';
                nodeObj.element.style.transform = isRightSide ? 'translate(0, -50%)' : 'translate(-100%, -50%)';
                dot.style.opacity = '1';
            }

            svgLayer.appendChild(path);
            svgLayer.appendChild(dot);
            paths.push(path);
            dots.push(dot);
            nodeObj.isRight = isRightSide;
        });
    }

    function playAnimations() {
        if (window.innerWidth <= 1024) return;

        const shuffled = Array.from(rawPieces).sort(() => 0.5 - Math.random());
        shuffled.forEach((piece, i) => {
            setTimeout(() => {
                piece.style.opacity = '1';
                piece.style.transform = 'scale(1)';
            }, i * TIMING.logoStaggerMs);
        });

        setTimeout(() => {
            paths.forEach(path => {
                const length = path.getTotalLength();
                path.style.strokeDasharray = length;
                path.style.strokeDashoffset = length;
                path.style.opacity = '1';

                path.getBoundingClientRect();
                path.style.transition = `stroke-dashoffset ${TIMING.linesDuration} cubic-bezier(0.22, 1, 0.36, 1)`;
                path.style.strokeDashoffset = '0';
            });
        }, TIMING.linesStartDelay);

        setTimeout(() => {
            dots.forEach(d => d.style.opacity = '1');
            nodes.forEach((n, i) => {
                setTimeout(() => {
                    n.element.style.opacity = '1';
                    n.element.style.transform = n.isRight ? 'translate(0, -50%)' : 'translate(-100%, -50%)';
                }, i * 40);
            });
        }, TIMING.nodesStartDelay);

        if (centerText) {
            setTimeout(() => {
                centerText.style.opacity = '1';
            }, TIMING.centerTextDelay);
        }
    }

    setupLayout(true);
    setTimeout(playAnimations, 50);

    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            setupLayout(false);
        }, 50);
    });

  });
</script>
